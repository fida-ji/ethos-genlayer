# Ethos deploy/seed configuration (repo root).
# Copy to .env and fill in. NEVER commit .env.

# Funded Bradbury account used to deploy and seed. Deploy/seed scripts read this
# via process.env only and never print it.
ACCOUNT_PRIVATE_KEY=0xyour_funded_bradbury_private_key

# Optional. Blank = the deployer address receives protocol fees.
FEE_RECIPIENT=

# Optional. Protocol settlement fee in basis points (100 = 1%). Default 100.
FEE_BPS=100
